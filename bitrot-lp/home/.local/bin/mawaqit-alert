#!/usr/bin/env python3
"""Prayer alert banner (Bitrot lp): an opaque card with the slice emblem on every monitor, above
fullscreen windows, without taking keyboard focus. Click to dismiss.

    mawaqit-alert '<json>'
      kind      "adhan" | "iqama"
      en, ar    prayer name ("Asr", "العصر")
      time      "17:00"          mosque  "Paris"
      iqama     "17:10" | null   iqama_ts  epoch of the iqama | null
      duration  seconds on screen
Sound: ~/.local/share/mawaqit/sounds/<kind>.wav; MAWAQIT_CHIME=<file> overrides,
MAWAQIT_CHIME= (empty) silences. Rings again after MAWAQIT_REPEAT seconds (60)
unless dismissed.

Launched by `waybar-mawaqit watch` (mawaqit-alerts.service). Namespace
hattin-mawaqit. Everything is drawn here with cairo; there are no image files.
"""

import json
import os
import subprocess
import sys
import time

LIB = "/usr/lib/libgtk4-layer-shell.so"
if LIB not in os.environ.get("LD_PRELOAD", ""):  # must load before libwayland
    os.environ["LD_PRELOAD"] = f"{LIB} {os.environ.get('LD_PRELOAD', '')}".strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gdk, GLib, Gtk, Gtk4LayerShell as LS, Pango, PangoCairo  # noqa: E402
import cairo  # noqa: E402

SOUNDS = os.path.expanduser("~/.local/share/mawaqit/sounds")  # adhan.wav, iqama.wav (make.py)
FALLBACK = "/usr/share/sounds/freedesktop/stereo/complete.oga"
REPEAT = int(os.environ.get("MAWAQIT_REPEAT", "60"))  # seconds until the reminder ring


def chime(kind):
    """MAWAQIT_CHIME overrides (empty = silent); else the bell for this kind."""
    if "MAWAQIT_CHIME" in os.environ:
        return os.environ["MAWAQIT_CHIME"]
    path = os.path.join(SOUNDS, f"{kind}.wav")
    return path if os.path.exists(path) else FALLBACK
M = 18                                   # room around the card for the phosphor bloom (tty)
W, H = 480, 132                          # the card
BLOOM = False                        # tty: a faint structure-green bloom around the adhan card


def rgb(h):
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


PANEL, STRUCT, ATT, PRI = rgb("E4EFD9"), rgb("2A6334"), rgb("8A5200"), rgb("1A1F1A")
NAME_PX, NAME_TRACK = 30, 5              # Sora 700, 30px, tracked 0.18em
GHOSTS = ((0.28, 0.44, -4, STRUCT), (0.62, 0.80, 4, ATT))   # band top, bottom (share of the height), shift, colour

CSS = b"""
window { background: transparent; }
.card { padding: 22px 18px 10px 82px; }
.ar   { font-family: "IBM Plex Sans Arabic", sans-serif; font-size: 22px; color: #2F5233; }
.tag  { font-family: "IBM Plex Mono", monospace; font-size: 11px; letter-spacing: 1px;
        color: #2A6334; border: 1px solid #2A6334; padding: 0 7px; margin-top: 6px; }
.tag.iqama { color: #F4F1E6; background: #8A5200; border-color: #8A5200; }
.sub  { font-family: "IBM Plex Mono", monospace; font-size: 12px; color: #2B3A2D; margin-top: 4px; }
.hint { font-family: "IBM Plex Mono", monospace; font-size: 11px; letter-spacing: 1px; color: #44614A; }
"""


def name_layout(cr, text):
    layout = PangoCairo.create_layout(cr)
    fd = Pango.FontDescription.from_string("Sora Bold")
    fd.set_absolute_size(NAME_PX * Pango.SCALE)
    layout.set_font_description(fd)
    attrs = Pango.AttrList()
    attrs.insert(Pango.attr_letter_spacing_new(NAME_TRACK * Pango.SCALE))
    layout.set_attributes(attrs)
    layout.set_text(text, -1)
    return layout


def name_size(text):
    cr = cairo.Context(cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1))
    w, h = name_layout(cr, text).get_pixel_size()
    return w + 8, h


def paint_name(cr, text):
    """The prayer name with the slice, at the current origin: the word in the text colour, then a
    green ghost band shifted left and an amber ghost band shifted right (no text of their own)."""
    layout = name_layout(cr, text)
    w, h = layout.get_pixel_size()
    cr.save()
    cr.move_to(4, 0)
    cr.set_source_rgb(*PRI)
    PangoCairo.show_layout(cr, layout)
    for top, bottom, dx, col in GHOSTS:
        cr.save()
        cr.rectangle(0, round(h * top), w + 8, round(h * (bottom - top)))
        cr.clip()
        cr.move_to(4 + dx, 0)
        cr.set_source_rgba(*col, 0.85)
        PangoCairo.show_layout(cr, layout)
        cr.restore()
    cr.restore()


def sliced_name(text):
    area = Gtk.DrawingArea(valign=Gtk.Align.CENTER)
    w, h = name_size(text)
    area.set_content_width(w)
    area.set_content_height(h)
    area.set_draw_func(lambda _a, cr, _w, _h: paint_name(cr, text))
    return area


def draw(iqama):
    """The card: panel fill and a 1px frame, structure green for the adhan, amber for the iqama; the
    emblem is three bands with the middle one displaced one cell (adhan green, amber, green; iqama
    the colours swapped). tty: a faint bloom in the structure colour around the adhan card."""
    edge = ATT if iqama else STRUCT
    outer, middle = (ATT, STRUCT) if iqama else (STRUCT, ATT)

    def fn(_area, cr, w, h):
        if BLOOM and not iqama:
            for i in range(M - 2, 0, -1):
                cr.rectangle(M - i, M - i, W + 2 * i, H + 2 * i)
                cr.set_source_rgba(*STRUCT, 0.011)
                cr.fill()
        cr.rectangle(M, M, W, H)
        cr.set_source_rgb(*PANEL)
        cr.fill()
        cr.rectangle(M + 0.5, M + 0.5, W - 1, H - 1)
        cr.set_source_rgb(*edge)
        cr.set_line_width(1)
        cr.stroke()
        ex, ey = M + 18, M + (H - 40) / 2
        for y, x, bw, col in ((6, 0, 46, outer), (17, 8, 38, middle), (28, 0, 46, outer)):
            cr.rectangle(ex + x, ey + y, bw, 7)
            cr.set_source_rgb(*col)
            cr.fill()
    return fn


def until(ts):
    s = max(0, int(ts - time.time()))
    m, s = divmod(s, 60)
    return f"in {m}m {s:02d}s" if m else f"in {s}s"


def build(app, a, monitor):
    win = Gtk.ApplicationWindow(application=app)
    LS.init_for_window(win)
    LS.set_namespace(win, "hattin-mawaqit")
    LS.set_layer(win, LS.Layer.OVERLAY)
    LS.set_anchor(win, LS.Edge.TOP, True)
    LS.set_margin(win, LS.Edge.TOP, 14 - M // 2)
    LS.set_keyboard_mode(win, LS.KeyboardMode.NONE)
    LS.set_monitor(win, monitor)
    win.set_default_size(W + 2 * M, H + 2 * M)

    iqama = a["kind"] == "iqama"
    area = Gtk.DrawingArea()
    area.set_content_width(W + 2 * M)
    area.set_content_height(H + 2 * M)
    area.set_draw_func(draw(iqama))

    name = sliced_name(a["en"].upper())
    ar = Gtk.Label(label=a["ar"], xalign=0, hexpand=True)
    ar.add_css_class("ar")
    tag = Gtk.Label(label="IQAMA" if iqama else "ADHAN", xalign=1, valign=Gtk.Align.START)
    tag.add_css_class("tag")
    if iqama:
        tag.add_css_class("iqama")
    title = Gtk.Box(spacing=12)
    title.append(name)
    title.append(ar)
    title.append(tag)

    sub = Gtk.Label(xalign=0)
    sub.add_css_class("sub")

    minutes = max(1, round(int(a.get("duration", 240)) / 60))
    hint = Gtk.Label(label=f"{minutes} MIN" if iqama else "DISMISS", xalign=1)
    hint.add_css_class("hint")

    def tick():
        head = f"{a['mosque']} · {a['time']}"
        if iqama:
            sub.set_label(f"{a['mosque']} · {a.get('iqama') or a['time']} · the prayer is starting")
        elif a.get("iqama_ts") and a["iqama_ts"] > time.time():
            sub.set_label(f"{head} · iqama {a['iqama']} · {until(a['iqama_ts'])}")
        elif a.get("iqama"):
            sub.set_label(f"{head} · iqama {a['iqama']} · now")
        else:
            sub.set_label(f"{head} · time for prayer")
        return True
    tick()
    GLib.timeout_add_seconds(1, tick)

    card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, valign=Gtk.Align.START)
    card.add_css_class("card")
    card.set_margin_top(M)
    card.set_margin_start(M)
    card.set_margin_end(M)
    for w in (title, sub, hint):
        card.append(w)

    over = Gtk.Overlay()
    over.set_child(area)
    over.add_overlay(card)
    win.set_child(over)

    click = Gtk.GestureClick()
    click.connect("pressed", lambda *_: app.quit())
    win.add_controller(click)
    win.present()


def main():
    a = json.loads(sys.argv[1])
    app = Gtk.Application(application_id=None)

    def activate(app):
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        disp = Gdk.Display.get_default()
        Gtk.StyleContext.add_provider_for_display(disp, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        mons = disp.get_monitors()
        for i in range(mons.get_n_items()):
            build(app, a, mons.get_item(i))
        app.hold()
        GLib.timeout_add_seconds(max(30, int(a.get("duration", 300))), app.quit)
        sound = chime(a["kind"])
        if sound and os.path.exists(sound):
            def ring():
                subprocess.Popen(["pw-play", "--media-role", "Notification", sound],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return False
            ring()
            # one reminder if the banner is still up; dismissing quits first
            GLib.timeout_add_seconds(REPEAT, ring)

    app.connect("activate", activate)
    app.run([])


if __name__ == "__main__":
    main()
