#!/usr/bin/env python3
"""fzf front end to Taskwarrior for the waybar "yawm" popups.

  bitrot-yawm-menu list       interactive list (the click popup)
  bitrot-yawm-menu add        one-line quick add (the right-click popup)

The rest are called from fzf bindings: rows, preview, done, delete, today,
annotate, create, undo. Every change pokes waybar (SIGRTMIN+10) so the
count updates at once.

Rows:  █ overdue (error) / ▓ due today (amber), ▒ dated later (secondary),
       ░ undated (dim), ¶ notes (+note, dim), listed last
"""

import json
import os
import shlex
import subprocess
import sys
from datetime import datetime, time, timedelta, timezone

SELF = os.path.abspath(__file__)
TASK = ["task", "rc.verbose=nothing", "rc.confirmation=off", "rc.hooks=off"]

FAIL = "\x1b[38;2;163;24;15m"
LIT = "\x1b[38;2;138;82;0m"
DATA = "\x1b[38;2;43;58;45m"
TEXT = "\x1b[38;2;26;31;26m"
STRUCT = "\x1b[38;2;47;82;51m"
QUIET = "\x1b[38;2;68;97;74m"
RESET = "\x1b[0m"

COLORS = ",".join([
    "bg:-1", "bg+:#CFE3C6", "fg:#1A1F1A", "fg+:#1A1F1A:regular",
    "hl:#2A6334:underline", "hl+:#2A6334:underline",
    "prompt:#2A6334", "query:#1A1F1A:regular", "ghost:#44614A",
    "pointer:#8A5200", "gutter:-1", "marker:#8A5200", "header:#2F5233",
    "info:#44614A", "input-border:#A9C3A4", "preview-border:#A9C3A4",
    "footer:#44614A", "spinner:#8A5200", "separator:#A9C3A4", "border:#2A6334",
])


def task(*args, capture=False):
    return subprocess.run(TASK + list(args), capture_output=capture, text=True)


def poke_bar():
    subprocess.run(["pkill", "-RTMIN+10", "-x", "waybar"], stderr=subprocess.DEVNULL)


def pending():
    raw = task("+PENDING", "export", capture=True).stdout
    try:
        return json.loads(raw or "[]")
    except ValueError:
        return []


def local_due(t):
    if "due" not in t:
        return None
    return datetime.strptime(t["due"], "%Y%m%dT%H%M%SZ").replace(tzinfo=timezone.utc).astimezone()


def classify(t, today):
    if "note" in t.get("tags", []):
        return "note"
    due = local_due(t)
    if due is None:
        return "open"
    if due.date() < today:
        return "overdue"
    if due.date() == today:
        return "today"
    return "later"


def when(due, today):
    if due.date() == today:
        return "today" if due.time() == time() else due.strftime("%H:%M")
    if due.date() == today + timedelta(days=1):
        return "tomorrow"
    if abs((due.date() - today).days) < 7:
        return due.strftime("%a")
    return due.strftime("%d %b")


def rows():
    today = datetime.now().date()
    order = {"overdue": 0, "today": 1, "later": 2, "open": 3, "note": 4}
    mark = {
        "overdue": f"{FAIL}█", "today": f"{LIT}▓", "later": f"{STRUCT}▒",
        "open": f"{QUIET}░", "note": f"{QUIET}¶",
    }
    far = datetime.max.replace(tzinfo=timezone.utc)
    items = []
    for t in pending():
        kind = classify(t, today)
        due = local_due(t)
        items.append((order[kind], due or far, -t.get("urgency", 0), kind, due, t))
    items.sort(key=lambda i: i[:3])

    for _, _, _, kind, due, t in items:
        meta = []
        if due:
            meta.append(when(due, today))
        if t.get("project"):
            meta.append(t["project"])
        meta += ["+" + g for g in t.get("tags", []) if g != "note"]
        if t.get("annotations"):
            meta.append(f"¶{len(t['annotations'])}")
        colour = QUIET if kind == "note" else TEXT
        hint = f"   {QUIET}{' · '.join(meta)}{RESET}" if meta else ""
        print(f"{t['uuid']}\t{mark[kind]}{RESET} {colour}{t['description']}{RESET}{hint}")


def preview(uuid):
    try:
        t = json.loads(task(uuid, "export", capture=True).stdout)[0]
    except (ValueError, IndexError):
        return
    today = datetime.now().date()
    print(f"{TEXT}{t['description']}{RESET}")
    facts = []
    due = local_due(t)
    if due:
        facts.append(f"due {due.strftime('%a %d %b %H:%M')}")
    if t.get("project"):
        facts.append(f"project {t['project']}")
    if t.get("tags"):
        facts.append(" ".join("+" + g for g in t["tags"]))
    kind = classify(t, today)
    if kind == "overdue":
        facts.append(f"{FAIL}overdue{RESET}{QUIET}")
    if facts:
        print(f"{QUIET}{'   '.join(facts)}{RESET}")
    for a in t.get("annotations", []):
        stamp = datetime.strptime(a["entry"], "%Y%m%dT%H%M%SZ").replace(tzinfo=timezone.utc).astimezone()
        print(f"{DATA}¶{RESET} {a['description']}  {QUIET}{stamp.strftime('%d %b')}{RESET}")


def create(text):
    words = text.split()
    if not words:
        return False
    task("add", *words, capture=True)
    poke_bar()
    return True


def toggle_today(uuid):
    try:
        t = json.loads(task(uuid, "export", capture=True).stdout)[0]
    except (ValueError, IndexError):
        return
    due = local_due(t)
    if due and due.date() == datetime.now().date():
        task(uuid, "modify", "due:", capture=True)
    else:
        task(uuid, "modify", "due:today", capture=True)
    poke_bar()


def fzf_list():
    me = shlex.quote(SELF)
    reload = f"reload({me} rows)"
    cmd = [
        "fzf",
        "--ansi", "--delimiter=\t", "--with-nth=2..",
        "--layout=reverse", "--no-sort",
        "--prompt=▶ ", "--pointer=▶", "--gutter= ",
        "--header=YAWM", "--header-first",
        "--highlight-line", "--no-scrollbar",
        "--info=inline-right",
        "--ghost=search · or type a task and C-A to add, C-N to note the selected one",
        "--input-border=bottom",
        "--preview", f"{me} preview {{1}}",
        "--preview-window=down,4,border-top,wrap",
        "--footer=RET DONE · C-A ADD · C-N NOTE · C-T TODAY · C-E EDIT · C-X DEL · C-Z UNDO",
        "--color=" + COLORS,
        "--bind", "ctrl-j:down,ctrl-k:up,esc:abort",
        "--bind", f"start:{reload}",
        "--bind", f"enter:execute-silent({me} done {{1}})+{reload}",
        "--bind", f"ctrl-a:execute-silent({me} create {{q}})+clear-query+{reload}",
        "--bind", f"ctrl-n:execute-silent({me} annotate {{1}} {{q}})+clear-query+{reload}",
        "--bind", f"ctrl-t:execute-silent({me} today {{1}})+{reload}",
        "--bind", f"ctrl-e:execute(task {{1}} edit)+execute-silent({me} poke)+{reload}",
        "--bind", f"ctrl-x:execute-silent({me} delete {{1}})+{reload}",
        "--bind", f"ctrl-z:execute-silent({me} undo)+{reload}",
    ]
    subprocess.run(cmd, stdin=subprocess.DEVNULL)


def fzf_add():
    cmd = [
        "fzf",
        "--disabled", "--layout=reverse", "--no-info",
        "--prompt=+  ",
        "--ghost=Buy bread due:today project:home +shop",
        "--input-border=bottom",
        "--footer=RET ADD · ESC CLOSE\n"
                  "due:today / tomorrow / fri / 2026-10-01   project:x   +tag   +note",
        "--color=" + COLORS,
        "--bind", "enter:accept-or-print-query,esc:abort",
    ]
    proc = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, text=True)
    text = proc.stdout.strip()
    if proc.returncode == 0 and create(text):
        subprocess.run(["notify-send", "-a", "yawm", "-t", "3000", "Task added", text],
                       stderr=subprocess.DEVNULL)


def main():
    args = sys.argv[1:] or ["list"]
    cmd, rest = args[0], args[1:]
    if cmd == "list":
        fzf_list()
    elif cmd == "add":
        fzf_add()
    elif cmd == "rows":
        rows()
    elif cmd == "preview" and rest:
        preview(rest[0])
    elif cmd == "create":
        create(" ".join(rest))
    elif cmd == "done" and rest:
        task(rest[0], "done", capture=True)
        poke_bar()
    elif cmd == "delete" and rest:
        task(rest[0], "delete", capture=True)
        poke_bar()
    elif cmd == "today" and rest:
        toggle_today(rest[0])
    elif cmd == "annotate" and len(rest) > 1 and rest[1].strip():
        task(rest[0], "annotate", rest[1], capture=True)
        poke_bar()
    elif cmd == "undo":
        task("undo", capture=True)
        poke_bar()
    elif cmd == "poke":
        poke_bar()


if __name__ == "__main__":
    main()
