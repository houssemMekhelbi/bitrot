# Taskwarrior. Shown in waybar as "yawm" (~/.local/bin/waybar-yawm):
#   click        list popup   (~/.local/bin/bitrot-yawm -> bitrot-yawm-menu)
#   right-click  quick add    (~/.local/bin/bitrot-yawm add)
# Tasks tagged +note are notes: listed last, never counted in the bar.

data.location=~/.local/share/task
news.version=3.5.0
editor=nvim
weekstart=monday

# Bitrot tty colours (256-colour approximations): overdue in the error red,
# due today in amber, active in the up green, notes dim.
color.due.today=bold rgb530
color.due=rgb142
color.overdue=bold rgb521
color.tag.note=rgb132
color.active=rgb252
color.header=rgb141
color.label=rgb141
color.footnote=rgb132
